# Copy to .env and adjust. docker compose reads .env automatically. The values
# below match the defaults in docker-compose.yml, so copying this file as-is
# changes nothing.

# Postgres container credentials (local development only). Postgres applies
# these only when it first creates the postgres-data volume: after changing
# them, run `docker compose down -v` to recreate it (this deletes local data).
POSTGRES_USER=foodie
POSTGRES_PASSWORD=foodie
POSTGRES_DB=foodie
# Host port Postgres is published on, for running the api or tools outside Docker.
POSTGRES_PORT=5432

# Host port the api is published on.
API_PORT=3000
LOG_LEVEL=info

# Used when running the api outside Docker (pnpm --filter @foodie/api dev).
# Inside compose the api gets its own DATABASE_URL pointing at the postgres service.
DATABASE_URL=postgres://foodie:foodie@localhost:5432/foodie

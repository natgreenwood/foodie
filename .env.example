# Copy to .env and adjust. docker compose reads .env automatically; every
# value below also has a local-dev default in docker-compose.yml.

# Postgres container credentials (local development only).
POSTGRES_USER=foodie
POSTGRES_PASSWORD=change-me
POSTGRES_DB=foodie
# Host port Postgres is published on, for running the api or tools outside Docker.
POSTGRES_PORT=5432

# Host port the api is published on.
API_PORT=3000
# Host port the web dev server is published on.
WEB_PORT=5173
LOG_LEVEL=info

# Used when running the api outside Docker (pnpm --filter @foodie/api dev).
# Inside compose the api gets its own DATABASE_URL pointing at the postgres service.
DATABASE_URL=postgres://foodie:change-me@localhost:5432/foodie
